# Kopyala: .env  (yerel geliştirme)
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Boşsa SQLite kullanılır. Supabase için bu satırı .env.local içinde doldur (git'e girmez):
#   Yerel / migration -> Session pooler (5432)
#   Vercel            -> Transaction pooler (6543)
# Parolada özel veya Türkçe karakter varsa URL'de yüzde-kodlanmalıdır.
DATABASE_URL=
# Örnek biçim:
# DATABASE_URL=postgresql://postgres.<proje-ref>:<PAROLA>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
